APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=replace-with-a-long-random-local-secret
INTERNAL_API_TOKEN=replace-with-a-separate-internal-token
AUTH_MODE=development
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_JSON=
DATABASE_URL=postgresql+asyncpg://supportguard_api:replace-api-password@localhost:5432/supportguard
MIGRATOR_DATABASE_URL=postgresql+asyncpg://supportguard_migrator:replace-migrator-password@localhost:5432/supportguard
MCP_READ_DATABASE_URL=postgresql+asyncpg://supportguard_read_mcp:replace-read-mcp-password@localhost:5432/supportguard
MCP_ACTION_DATABASE_URL=postgresql+asyncpg://supportguard_action_mcp:replace-action-mcp-password@localhost:5432/supportguard
MIGRATOR_DATABASE_PASSWORD=replace-migrator-password
API_DATABASE_PASSWORD=replace-api-password
DISPATCHER_DATABASE_PASSWORD=replace-dispatcher-password
RECONCILER_DATABASE_PASSWORD=replace-reconciler-password
WORKER_DATABASE_PASSWORD=replace-worker-password
READ_MCP_DATABASE_PASSWORD=replace-read-mcp-password
ACTION_MCP_DATABASE_PASSWORD=replace-action-mcp-password
BOOTSTRAP_DATABASE_PASSWORD=replace-bootstrap-password
MAINTENANCE_DATABASE_PASSWORD=replace-maintenance-password
REDIS_URL=redis://localhost:6379/0
RUNTIME_THRESHOLD_SCHEMA_VERSION=runtime-thresholds.v1
RUNTIME_OPERATIONAL_HORIZON_SECONDS=600
RUNTIME_JOB_LEASE_SECONDS=30
RUNTIME_HEARTBEAT_INTERVAL_SECONDS=10
RUNTIME_RECONCILER_INTERVAL_SECONDS=5
REDIS_PEL_MIN_IDLE_MS=35000
TENANT_COMMANDS_PER_MINUTE=60
PRINCIPAL_COMMANDS_PER_MINUTE=20
FALLBACK_COMMANDS_PER_MINUTE=10
MAX_DURABLE_BACKLOG=500
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_ENABLED=false
LLM_TEMPERATURE=0
DEMO_FAKE_PROVIDER=0
EMBEDDING_MODEL=intfloat/multilingual-e5-small
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
MAX_EXTERNAL_EVAL_COST_CNY=30
RETENTION_EVENT_DAYS=30
RETENTION_DELIVERY_DAYS=14
RETENTION_TRACE_DAYS=30
